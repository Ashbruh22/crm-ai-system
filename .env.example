# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── Required ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-long-random-string
DB_USER=crm_ai_app
DB_PASSWORD=crm_ai_db_password_dev
# docker compose overrides these two with its internal hostnames.
DATABASE_URL=postgresql+asyncpg://crm_ai_app:crm_ai_db_password_dev@db:5432/crm_ai
REDIS_URL=redis://redis:6379/0

# For a local run with no containers, SQLite works and needs no server:
# DATABASE_URL=sqlite+aiosqlite:///./demo_local.db

# ─── CORS (spec section 10) ──────────────────────────────────────────────────
# Comma-separated dashboard origins. "*" is rejected at startup: it cannot be
# combined with credentialed requests, and the old code shipped exactly that.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Service ─────────────────────────────────────────────────────────────────
WEB_CONCURRENCY=4
DOCS_ENABLED=true
BATCH_CONCURRENCY=10
# Overrides the version read from artifacts/metrics.json.
MODEL_VERSION=

# ─── Startup ─────────────────────────────────────────────────────────────────
# Seed the 60-deal live set when the deals table is empty.
SEED_ON_STARTUP=true
# Refuse to boot if artifacts are missing or the feature schema has drifted.
# Leave true: a drifted schema produces confidently wrong explanations.
REQUIRE_ARTIFACTS=true

# ─── Ingestion bus ───────────────────────────────────────────────────────────
# The stream consumer runs inside the API process, so the hosted demo needs one
# Render service rather than two. Requires Redis >= 5 (streams); the service
# reports a clear error in /healthz on anything older.
RUN_CONSUMER=true
CONSUMER_NAME=worker-1

# ─── Ingestion ───────────────────────────────────────────────────────────────
CRM_WEBHOOK_SECRET=your-hmac-secret-here
CRM_SIMULATE_ENABLED=true
# Replay window for signed webhooks, in seconds.
WEBHOOK_TIMESTAMP_TOLERANCE=300

# ─── Admin ───────────────────────────────────────────────────────────────────
# Required by POST /api/admin/reset and the nightly reset job. Must be at least
# 16 characters; below that the service keeps admin routes disabled rather than
# pretend to be protected. Unset means disabled, never open.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
