# Secret keys and passwords
SECRET_KEY=change-this-in-production-long-random-string
DB_PASSWORD=crm_ai_db_password_dev

# Database Configuration
# The DB_USER and POSTGRES_DB need to match docker-compose.yml
DB_USER=crm_ai_app
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/crm_ai

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Settings
WEB_CONCURRENCY=4
DOCS_ENABLED=true
BATCH_CONCURRENCY=10

# CRM Integration Settings
CRM_WEBHOOK_SECRET=your-hmac-secret-here
CRM_SIMULATE_ENABLED=true
